# Copy to chatbot/.env and fill in. Names match chatbot/backend/config.py.

# MongoDB Atlas connection string (database: gov_scheme_ai, collection: schemes)
MONGODB_URI=

# Groq (LLM answers + document field extraction). GROQ_MODEL has no default and must be set.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Local Ollama fallback (optional). The config default is qwen2.5:3b; the report used gemma3:4b.
OLLAMA_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434

# ChromaDB location (relative to the repo root)
CHROMA_PERSIST_PATH=chatbot/data/chroma_db

# Scheme sync pipeline (optional; no live sync is needed to run the chatbot)
MYSCHEME_BASE_URL=https://api.myscheme.gov.in
MYSCHEME_SITE_URL=https://www.myscheme.gov.in
MYSCHEME_API_KEY=
SYNC_API_KEY=
SYNC_SCHEDULER_ENABLED=false
